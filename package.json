    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "effect": "^3.19.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "fast-check": "^4.5.3",
    "postcss": "^8.5.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
