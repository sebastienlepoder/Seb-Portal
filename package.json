{
  "name": "lepoder-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx scripts/seed.ts && npx tsx scripts/seed-agents.ts",
    "db:seed:agents": "npx tsx scripts/seed-agents.ts",
    "worker": "npx tsx worker/index.ts",
    "backup": "npx tsx scripts/backup.ts",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@anthropic-ai/sdk": "^0.98.0",
    "@prisma/client": "^6.3.0",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.14.0",
    "empathic": "^2.0.0",
    "fuse.js": "^7.0.0",
    "iron-session": "^8.0.4",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.474.0",
    "mermaid": "^11.15.0",
    "next": "^14.2.23",
    "openai": "^6.39.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.0.5",
    "zod": "^4.4.3"
