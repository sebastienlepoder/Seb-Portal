generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  role          String   @default("user") // admin | user
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  favorites        Favorite[]
  notes            AiNote[]
  aiThreads        AiThread[]
  aiMemories       AiMemory[]
  bookmarks        Bookmark[]
  auditLogs        AuditLog[]
  clickEvents      ClickEvent[]
  urgentItems      UrgentItem[]
  microsoftAccount MicrosoftAccount?
  todos            Todo[]
}

// ─── Microsoft Account (Graph API) ──────────────────────────

model MicrosoftAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  msUserId     String   // Microsoft user ID
  email        String   // Microsoft email
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String   // granted scopes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Services ────────────────────────────────────────────────

model Service {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  url             String
  type            String   @default("external") // internal|external|github|email|remote|bookmark|tool|ai
  description     String?
  tags            String?  // JSON array
  category        String   @default("Uncategorized")
  section         String   @default("General")
  openMode        String   @default("new_tab") // new_tab|iframe|modal|sidepanel
  requiresVPN     Boolean  @default(false)
  statusCheckUrl  String?
  statusEnabled   Boolean  @default(true)
  favoriteDefault Boolean  @default(false)
  icon            String?  // path or URL
  iconGenerated   Boolean  @default(false)
  credentialsHint String?  // admin-only, never real secrets
  sortOrder       Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favorites   Favorite[]
  clickEvents ClickEvent[]
  statusLogs  StatusLog[]
}

// ─── Favorites ───────────────────────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

// ─── Status Logs ─────────────────────────────────────────────

model StatusLog {
  id        String   @id @default(uuid())
  serviceId String
  status    String   // green|yellow|red|gray
  latencyMs Int?
  message   String?
  checkedAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt])
}

// ─── Audit Logs ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // login_success|login_fail|logout|admin_action|...
  details   String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}

// ─── Activity Stream ─────────────────────────────────────────
// Denormalized firehose of user-visible events surfaced in the
// live activity feed (SSE). Distinct from AuditLog: AuditLog is
// security-forensics-grade and links to users; Activity rows are
// short-lived display rows safe to render verbatim.

model Activity {
  id          String   @id @default(uuid())
  type        String   // dot-namespaced: "auth.login" | "service.launched" | "mcp.executed" | "task.created" | ...
  entityType  String?  // "service" | "task" | "tool" | "user"
  entityId    String?
  actor       String?  // userId, "system", "n8n", or agent slug
  description String   // pre-rendered, human-readable line
  data        String?  // optional JSON payload
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

// ─── Skills Hub ──────────────────────────────────────────────
// Local-only registry of agent skill files (.md under skills/).
// Each row is the result of a sync pass: the file's sha256 lets
// us skip rescans when nothing changed; the security report is
// produced by the multi-pass scanner and gates whether the skill
// can be enabled.

model Skill {
  id             String    @id @default(uuid())
  source         String    @default("local")          // future: "github"
  name           String                                 // file basename without .md
  filePath       String                                 // relative path under skills/
  description    String?                                // first non-heading paragraph, if any
  contentHash    String                                 // sha256 of file bytes
  securityStatus String    @default("unchecked")        // clean | warning | rejected | unchecked
  securityReport String?                                // JSON-encoded ScanReport
  enabled        Boolean   @default(false)
  lastScannedAt  DateTime?
  installedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([source, name])
  @@index([securityStatus, enabled])
}

// ─── MCP Tool Call Log ───────────────────────────────────────
// Per-call analytics for trust scoring and the admin MCP dashboard.
// Distinct from AuditLog (which logs the same call but lacks fast
// per-tool aggregation indexes). Inputs/results pass through a
// secret-scrubber before persistence; size-capped to keep the table
// from growing unbounded.

model McpCallLog {
  id            String   @id @default(uuid())
  toolName      String
  callerId      String?                       // user id or "scheduler"
  callerKind    String   @default("user")     // "user" | "scheduler" | "api"
  success       Boolean
  durationMs    Int
  inputJson     String?                       // sanitised, capped 2KB
  resultPreview String?                       // first 500 chars of result, sanitised
  error         String?                       // error message if !success
  createdAt     DateTime @default(now())

  @@index([toolName, createdAt])
  @@index([callerId, createdAt])
  @@index([createdAt])
}

// ─── Recurring Schedules ─────────────────────────────────────
// Cron-driven dispatch templates. Evaluated once per minute from
// the worker tick. Three dispatch kinds: "mcp" (call an MCP tool),
// "webhook" (HTTP POST), or "task" (create a Task row).

model RecurringTask {
  id            String    @id @default(uuid())
  title         String
  description   String?
  naturalText   String                  // user-typed phrase, e.g. "every weekday at 9am"
  cronExpr      String                  // resolved cron, e.g. "0 9 * * 1-5"
  humanReadable String                  // pretty-printed cron, from cronstrue

  kind          String                  // "mcp" | "webhook" | "task"
  payload       String                  // JSON, shape depends on kind

  enabled       Boolean   @default(true)
  lastSpawnedAt DateTime?
  nextRunAt     DateTime?
  spawnCount    Int       @default(0)
  lastError     String?
  lastCatchUpAt DateTime?

  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

// ─── Click / Usage Events ────────────────────────────────────

model ClickEvent {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@index([userId, createdAt])
}

// ─── AI Notes ────────────────────────────────────────────────

model AiNote {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  content   String
  tags      String?  // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AI Chat Threads ─────────────────────────────────────────

model AiThread {
  id        String   @id @default(uuid())
  userId    String
  provider  String   // openai | anthropic
  title     String?
  messages  String   // JSON array of {role, content}
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  tags      String?  // JSON array of strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived, pinned, updatedAt])
}

// ─── AI Assistant Memory ─────────────────────────────────────
// Key/value scratchpad the AI assistant reads & writes via MCP
// tools (read_memory / write_memory). Scoped per user.

model AiMemory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  type      String   @default("general") // user|project|feedback|reference|general
  value     String   // free-form text payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, type])
}

// ─── Bookmarks (imported) ────────────────────────────────────

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  title     String
  url       String
  folder    String?
  icon      String?
  tags      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Urgent Inbox Items ──────────────────────────────────────

model UrgentItem {
  id        String   @id @default(uuid())
  userId    String?
  source    String   @default("n8n") // n8n | manual
  priority  String   @default("normal") // critical|high|normal|low
  title     String
  snippet   String?
  actionUrl String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([done, createdAt])
}

// ─── Icon Cache ──────────────────────────────────────────────

model IconCache {
  id        String   @id @default(uuid())
  key       String   @unique // domain or service slug
  path      String   // file path on disk
  provider  String   // cloud_api | fallback
  createdAt DateTime @default(now())
}

// ─── App Settings ────────────────────────────────────────────

model AppSetting {
  key   String @id
  value String
}

// ─── Projects ────────────────────────────────────────────────

model Project {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  repoUrl       String?  // GitHub repo URL (e.g. https://github.com/owner/repo)
  repoOwner     String?  // GitHub owner (org or user)
  repoName      String?  // GitHub repo name
  workingBranch String   @default("main") // branch the worker should push to / open PRs against
  clonePath     String?  // optional pre-configured clone path on the worker host
  allowWrite    Boolean  @default(false) // worker may push commits / open PRs to this repo
  status        String   @default("active") // active|paused|completed|archived
  kind          String   @default("digital") // digital|physical
  icon          String?  // emoji or icon path
  color         String?  // accent color
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        ProjectSession[]
  tasks           Task[]
  secretMappings  ProjectSecretMapping[]
}

model ProjectSession {
  id        String   @id @default(uuid())
  projectId String
  title     String
  summary   String   // markdown content
  date      DateTime @default(now())
  tags      String?  // JSON array

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model Todo {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String    @default("General")
  priority    Int       @default(0) // 0=normal, 1=medium, 2=high
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, category])
}

// ─── Amonis Finance Agent System ─────────────────────────────

model AmonisAgent {
  id           String   @id @default(uuid())
  slug         String   @unique // budget, transactions, accounts, crypto, goals, settings, research, designer, devil
  name         String
  description  String?
  systemPrompt String?  // customizable system prompt for this agent
  icon         String?  // emoji or icon name
  color        String?  // accent color
  scope        String?  // which files/folders this agent handles
  status       String   @default("idle") // idle | working | waiting_review
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks AmonisTask[]
  logs  AmonisAgentLog[]
}

model AmonisAgentLog {
  id        String   @id @default(uuid())
  agentId   String
  taskId    String?
  type      String   @default("info") // info | thinking | action | error
  message   String
  metadata  String?  // JSON for extra data
  createdAt DateTime @default(now())

  agent AmonisAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model AmonisTask {
  id              String    @id @default(uuid())
  agentId         String?
  title           String
  description     String?   // detailed task description
  status          String    @default("pending") // pending | assigned | in_progress | review_design | review_devil | needs_review | approved | rejected | done
  priority        Int       @default(1) // 0=low, 1=normal, 2=high, 3=urgent
  platforms       String    @default("both") // desktop | mobile | both
  
  // Work results
  workSummary     String?   // what was done (markdown)
  filesChanged    String?   // JSON array of file paths
  screenshotBefore       String?  // desktop before screenshot
  screenshotAfter        String?  // desktop after screenshot
  screenshotBeforeMobile String?  // mobile before screenshot
  screenshotAfterMobile  String?  // mobile after screenshot
  
  // Reviews
  designerNotes   String?   // Designer agent feedback
  designerApproved Boolean?
  devilNotes      String?   // Devil's advocate feedback
  devilApproved   Boolean?
  
  // Tracking
  assignedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  reviewedAt      DateTime?
  
  // Build tracking
  buildNumber     Int?      // TestFlight build this was included in
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agent AmonisAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([agentId, status])
}

model AmonisBuild {
  id            String   @id @default(uuid())
  buildNumber   Int      @unique
  version       String   @default("1.0")
  status        String   @default("pending") // pending | building | uploading | processing | ready | failed
  taskIds       String?  // JSON array of task IDs included
  commitHash    String?
  errorMessage  String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
}

// ─── Agent Dispatch System ───────────────────────────────────
// General-purpose agent profiles + a task queue dispatched from
// the AI Hub to a headless worker that runs Claude against a
// cloned repo.

model AgentProfile {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  role         String   // e.g. "Layout Specialist", "Architecture Expert"
  expertise    String   @default("[]") // JSON array of tags: ["frontend","finance",...]
  description  String?
  systemPrompt String   // custom instructions used when this agent is invoked
  model        String?  // optional override (e.g. claude-opus-4-7); null = use worker default
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks Task[]

  @@index([isActive, sortOrder])
}

model Task {
  id              String    @id @default(uuid())
  projectId       String
  agentProfileId  String?
  createdById     String?   // user that dispatched the task

  // Orchestration: when an Orchestrator agent runs, it dispatches sub-tasks
  // that share the parent's workdir and branch. parentTaskId links them.
  // Top-level tasks have parentTaskId=null.
  parentTaskId    String?

  title           String
  description     String    // detailed instructions for the agent
  priority        String    @default("normal") // low | normal | high | urgent
  status          String    @default("pending") // pending | queued | in_progress | needs_review | completed | failed | cancelled
  /**
   * When true and the project is write-enabled, the worker auto-merges
   * the PR it opens via GitHub API after creation. Set per-task from
   * the dispatcher's "Merge to main automatically" checkbox.
   */
  autoMerge       Boolean   @default(false)

  // Worker tracking
  workerId        String?   // set when a worker locks the task
  workerStartedAt DateTime?
  completedAt     DateTime?

  // Review tracking — when the worker finishes, status goes to
  // needs_review; the user then transitions it to completed via the
  // mark_reviewed / merge_and_review PATCH actions.
  reviewedAt      DateTime?
  reviewedById    String?
  mergedAt        DateTime?

  // Result
  resultType      String?   // "commit" | "pr" | "summary"
  resultUrl       String?   // PR URL, commit URL, or null
  resultSummary   String?   // markdown summary written by the agent
  errorMessage    String?

  // SDK-reported dollar cost. This is a token-count × pricing estimate
  // the SDK computes regardless of auth path — even Max-OAuth runs report
  // a non-zero number ("what this would have cost on the API"). It is NOT
  // the same as what Anthropic actually billed. Use `authPath` below to
  // tell which runs incurred real charges.
  costUsd         Float?

  // Auth path the worker used for this run. Recorded at completion time so
  // the dashboard can show real spend (sum of costs where authPath='api_key')
  // separately from SDK estimates on OAuth runs. Null on legacy rows.
  authPath        String?   // 'oauth' | 'api_key'

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentProfile AgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  parent       Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children     Task[]        @relation("TaskHierarchy")
  logs         TaskLog[]
  attachments  TaskAttachment[]

  @@index([status, priority, createdAt])
  @@index([projectId, status])
  @@index([agentProfileId, status])
  @@index([parentTaskId])
}

model TaskLog {
  id        String   @id @default(uuid())
  taskId    String
  level     String   @default("info") // info | warn | error | stdout | stderr
  message   String
  metadata  String?  // optional JSON
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  mimeType   String   // e.g. image/png
  dataBase64 String   // raw base64 (no data URI prefix)
  filename   String?  // optional original name
  byteSize   Int
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── 1Password Connect Integration ───────────────────────────

model OnePasswordConnection {
  id              String    @id @default(uuid())
  // Single-row config (we only support one Connect server). Use a fixed slug "default".
  slug            String    @unique @default("default")
  connectHost     String    // e.g. http://onepassword-connect:8080
  encryptedToken  String    // AES-256-GCM ciphertext, base64
  tokenIv         String    // base64
  tokenTag        String    // base64
  defaultVaultId  String?
  lastTestedAt    DateTime?
  lastTestStatus  String?   // ok | failed
  lastTestMessage String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ProjectSecretMapping {
  id         String   @id @default(uuid())
  projectId  String
  envName    String   // e.g. OPENAI_API_KEY — the name the worker will export
  vaultId    String
  itemId     String
  fieldLabel String   // 1Password field label, e.g. "credential" or "password"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, envName])
  @@index([projectId])
}
