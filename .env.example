# ============================================================
# LEPODER Portal — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Core ---
NODE_ENV=production
BASE_URL=https://lepoder.com
PORT=3000

# --- Database (SQLite) ---
DATABASE_URL="file:./data/portal.db"

# --- Auth / Sessions ---
# REQUIRED — no default. Generate with: openssl rand -hex 32
# The process will throw at startup if this is unset.
AUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# REQUIRED — no default. Generate with: openssl rand -hex 32
# The process will throw at startup if this is unset.
CSRF_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_CHAR_HEX_STRING

# --- Amonis Worker ---
# REQUIRED — shared secret between the portal and the Amonis worker daemon.
# No default. Generate with: openssl rand -hex 32
# The process will throw at startup if this is unset.
AMONIS_API_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_HEX_STRING

# --- Admin Bootstrap (first run only) ---
ADMIN_EMAIL=admin@lepoder.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
# Optional TOTP secret for admin 2FA (base32 encoded)
# ADMIN_TOTP_SECRET=

# --- Icon Generation API ---
# ICON_API_URL=https://your-icon-api.com/generate
# ICON_API_KEY=

# --- VPN / Tailscale ---
# Options: ping_url | tailscale_local_api | manual
VPN_HEALTHCHECK_MODE=ping_url
VPN_HEALTHCHECK_URL=http://100.100.100.100:80/healthz
# Tailscale local API (advanced)
# TAILSCALE_API_URL=http://localhost:41112

# --- Reports ---
REPORT_RETENTION_DAYS=90

# --- AI / LLM (optional) ---
# OPENAI_API_KEY=sk-...
# Used by the portal's in-app AI chat. The dispatch worker reads OAuth
# credentials from /home/nextjs/.claude/.credentials.json instead — see the
# Agent Dispatch Worker section below.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=http://192.168.1.130:3456
# OpenRouter (optional) — unlocks Gemini / DeepSeek / Llama in the chat
# model picker via one OpenAI-compatible key. Text-only (no tool use).
# OPENROUTER_API_KEY=sk-or-...

# --- Weather (optional) ---
# Providers: openweathermap | homeassistant
# WEATHER_PROVIDER=openweathermap
# WEATHER_API_KEY=
# WEATHER_LOCATION=New York,US
# For Home Assistant weather:
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_WEATHER_ENTITY=weather.home

# --- Markets (optional) ---
# Providers: alphavantage | finnhub | polygon
# MARKET_PROVIDER=alphavantage
# MARKET_DATA_API_KEY=
# MARKET_WATCHLIST=SPY,QQQ,AAPL,MSFT

# --- Shopify (optional) ---
# SHOPIFY_SHOP_DOMAIN=acrylicunitedstates.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...

# --- Microsoft Graph / OneNote (optional) ---
# MSFT_CLIENT_ID=
# MSFT_CLIENT_SECRET=
# MSFT_TENANT=common
# MSFT_REDIRECT_URI=https://lepoder.com/api/microsoft/callback

# --- Synology (optional) ---
# SYNOLOGY_URL=https://synology.local:5001
# SYNOLOGY_USERNAME=
# SYNOLOGY_PASSWORD=

# --- MCP (optional) ---
# MCP_ENABLED=true
# MCP_AUTH_TOKEN=CHANGE_ME

# --- Compose: persistent storage path ---
# Override the SQLite/data volume mount in docker-compose.yml. Leave unset
# to use a Docker named volume (default). Set to a host bind path for
# Coolify or any other host that already has a managed data directory:
# PORTAL_DATA_VOLUME=/data/coolify/lepoder-portal

# --- Agent Dispatch Worker ---
#
# Auth: the worker uses the Claude Agent SDK. To run on a Claude Max
# subscription (no per-token billing), bootstrap credentials once:
#
#   1. On any machine with a browser:
#        npm i -g @anthropic-ai/claude-agent-sdk   # or `npm i -g @anthropic-ai/claude-code`
#        claude login
#      Log into your Max account. This writes ~/.claude/.credentials.json.
#   2. Copy that file to the deploy host at the path pointed to by
#      CLAUDE_CREDS_DIR below (default /data/coolify/lepoder-portal/claude-creds),
#      and `chown -R 1001:1001` the dir so the worker's user can write to it.
#   3. Redeploy. The worker mounts the dir read-WRITE at /home/nextjs/.claude
#      so the SDK can refresh the (daily-expiring) OAuth access token in place.
#
# If no credentials are present, the SDK falls back to ANTHROPIC_API_KEY
# (set in the AI / LLM section above) and bills per-token instead.
#
# CLAUDE_CREDS_DIR=/data/coolify/lepoder-portal/claude-creds
#
# GitHub token used by the worker to clone private repos and open PRs.
# Needs `repo` scope. Required if any project has allowWrite=true.
# Also powers "Sync repos" on /projects (turns your repos into projects).
# GITHUB_TOKEN=ghp_...
# Repo-sync scope (all optional):
#   GITHUB_SYNC_INTERVAL_MIN   auto-sync interval in minutes (default 60, 0=off)
#   GITHUB_SYNC_AFFILIATION    /user/repos affiliation: owner | collaborator | organization_member (default owner)
#   GITHUB_SYNC_ORG            list a specific org's repos instead of the user's
#   GITHUB_SYNC_INCLUDE_FORKS  "true" to include forks (default excludes them)
# GITHUB_SYNC_INTERVAL_MIN=60
# Override the worker defaults (all optional)
# WORKER_ID=portal-worker-1
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_TIMEOUT_MS=300000        # per-task hard timeout
# WORKER_MAX_TURNS=100            # Claude Agent SDK turn budget per subagent
# WORKER_CONCURRENCY=1            # max simultaneous tasks
# WORKER_DEFAULT_MODEL=claude-sonnet-4-6
# Persistent clone directory. Defaults to /app/worker-clones (the compose
# named volume). Set to a different host path for local dev. Each repo
# gets a subdirectory `<owner>__<name>/` so subsequent tasks reuse the
# checkout + node_modules.
# WORKER_CLONES_DIR=/app/worker-clones
# Worker auto-runs `npm ci` (or `npm install`) after clone if node_modules
# is missing or older than package-lock.json. Skips when up-to-date.
# WORKER_NPM_INSTALL_TIMEOUT_MS=300000  # 5 min hard cap for the install
# WORKER_SKIP_NPM_INSTALL=false         # set true to disable entirely

# --- 1Password Connect (optional) ---
# Dedicated AES-256-GCM encryption key for the stored Connect token.
# Falls back to AUTH_SECRET when unset; set this to isolate the 1Password
# credential from the session secret.
# ONEPASSWORD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# --- Urgent Inbox Webhook ---
# Token for n8n webhook auth
# WEBHOOK_AUTH_TOKEN=CHANGE_ME

# --- Apache Guacamole (Remote Desktop) ---
# GUACAMOLE_URL=http://localhost:8080/guacamole
# GUACAMOLE_USER=guacadmin
# GUACAMOLE_PASS=guacadmin
# NEXT_PUBLIC_GUACAMOLE_URL=http://localhost:8080/guacamole

# --- RustDesk (Self-hosted) ---
# RUSTDESK_SERVER=your-server-ip
# RUSTDESK_PUBLIC_KEY=your-public-key

# See docs/WEB-SSH-TERMINAL.md for full configuration guidance.
# --- Web SSH Terminal (admin-only) ---
# Set to 'true' to completely disable the Web SSH Terminal feature.
# Affects both the WS upgrade handler and the sidebar nav entry.
# DISABLE_TERMINAL=false
#
# Comma-separated allowlist of SSH target hostnames/IPs.
# When set, any connection attempt to a host not in the list is rejected.
# Leave unset to allow any reachable host (Tailscale network + LAN).
# TERMINAL_HOST_ALLOWLIST=server1.tail12345.ts.net,192.168.1.100
